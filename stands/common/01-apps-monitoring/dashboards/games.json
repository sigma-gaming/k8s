{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.4.3"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "title": "Games",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "graphTooltip": 2,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "${DS_PROMETHEUS}"
        },
        "hide": 0,
        "includeAll": false,
        "label": "datasource",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "type": "query",
        "name": "namespace",
        "query": "label_values(games_bets_amount, namespace)",
        "label": "Namespace",
        "includeAll": true,
        "allValue": ".+"
      },
      {
        "type": "query",
        "name": "game",
        "query": "label_values(games_bets_amount, game)",
        "label": "Game",
        "includeAll": true,
        "allValue": ".+"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Bets",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Amount of Bets",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (game) (increase(games_bets_amount{namespace=~\"$namespace\",game=~\"$game\"})) / 100",
          "legendFormat": "Bets ({{game}})",
          "refId": "A",
          "interval": "5m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 100
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Amount of Wins",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "games_total_amount{namespace=~\"$namespace\",type=\"Win\",game=~\"$game\"} / 100",
          "legendFormat": "Wins ({{game}})",
          "refId": "A",
          "interval": "5m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 100
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Amount of Losses",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "games_total_amount{namespace=~\"$namespace\",type=\"Loss\",game=~\"$game\"} / 100",
          "legendFormat": "Losses ({{game}})",
          "refId": "A",
          "interval": "5m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 100
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      }
    },
    {
      "type": "row",
      "title": "Game Types",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "collapsed": false
    },
    {
      "type": "piechart",
      "title": "Dice Sides Distribution",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "sum"
          ],
          "fields": ""
        },
        "pieType": "pie",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "displayLabels": [
          "name"
        ]
      },
      "targets": [
        {
          "expr": "sum by () (increase(games_dice_sides_bucket{le=\"1\", namespace=~\"$namespace\"}))",
          "legendFormat": "1 side",
          "refId": "A"
        },
        {
          "expr": "sum by () (increase(games_dice_sides_bucket{le=\"2\", namespace=~\"$namespace\"})) - sum by () (increase(games_dice_sides_bucket{le=\"1\", namespace=~\"$namespace\"}))",
          "legendFormat": "2 sides",
          "refId": "B"
        },
        {
          "expr": "sum by () (increase(games_dice_sides_bucket{le=\"3\", namespace=~\"$namespace\"})) - sum by () (increase(games_dice_sides_bucket{le=\"2\", namespace=~\"$namespace\"}))",
          "legendFormat": "3 sides",
          "refId": "C"
        },
        {
          "expr": "sum by () (increase(games_dice_sides_bucket{le=\"4\", namespace=~\"$namespace\"})) - sum by () (increase(games_dice_sides_bucket{le=\"3\", namespace=~\"$namespace\"}))",
          "legendFormat": "4 sides",
          "refId": "D"
        },
        {
          "expr": "sum by () (increase(games_dice_sides_bucket{le=\"5\", namespace=~\"$namespace\"})) - sum by () (increase(games_dice_sides_bucket{le=\"4\", namespace=~\"$namespace\"}))",
          "legendFormat": "5 sides",
          "refId": "E"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      }
    },
    {
      "type": "piechart",
      "title": "Pincode Mode Distribution",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "options": {
        "reduceOptions": {
