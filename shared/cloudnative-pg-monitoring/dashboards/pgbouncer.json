        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (database) (cnpg_pgbouncer_pools_cl_waiting{namespace=~\"$namespace\",job=~\"$job\"})",
          "legendFormat": "{{database}}",
