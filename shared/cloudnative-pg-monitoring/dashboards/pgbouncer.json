          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(cnpg_pgbouncer_pools_sv_active{namespace=~\"$namespace\",job=~\"$job\"}) by (database)",
          "legendFormat": "Active - {{database}}",
          "refId": "A"
        },
        {
          "expr": "sum(cnpg_pgbouncer_pools_sv_idle{namespace=~\"$namespace\",job=~\"$job\"}) by (database)",
          "legendFormat": "Idle - {{database}}",
